# PayPal Sandbox app credentials (developer.paypal.com → Apps & Credentials → Sandbox)
# Enable "Disputes" in the app's feature options.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional LLM (any OpenAI-compatible endpoint; free tiers: Groq, Gemini, OpenRouter, or local Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: webhook ID from the sandbox app, to verify webhook signatures
PAYPAL_WEBHOOK_ID=
# Fetch disputes through the official PayPal MCP server (needs Node.js/npx)
PAYPAL_USE_MCP=1

# Optional: pixel-based AI-image detection for uploaded evidence (Sightengine "genai" model).
# Off unless both are set. Sends merchant images to Sightengine. Free tier: https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
